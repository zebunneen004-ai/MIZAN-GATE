  "locked_claims": [
    {
      "id": "ELLIPTIC_TIME_001",
      "statement": "Elliptic contains 49 approximately two-week-spaced time steps; each released time step is one connected component spanning transactions within less than approximately three hours, with no released edges between time steps.",
      "source_ids": ["S1", "S2"]
    },
    {
      "id": "ELLIPTIC_TIME_002",
      "statement": "The original paper describes timing as estimated confirmation time, while the official dataset card describes it as broadcast timing; therefore the released time_step is not accepted by MIZAN as an exact transaction-level decision timestamp.",
      "source_ids": ["S1", "S2"]
    },
    {
      "id": "ELLIPTIC_FEATURE_001",
      "statement": "The original feature matrix contains 94 nominally local features including time step and 72 aggregated one-hop neighborhood features.",
      "source_ids": ["S1", "S2"]
    },
    {
      "id": "ELLIPTIC_AUDIT_001",
      "statement": "The 2026 peer-reviewed audit reports recovery of 91 of 94 local feature semantics and 60 of 72 aggregated neighborhood feature semantics.",
      "source_ids": ["S3", "S4"]
    },
    {
      "id": "ELLIPTIC_AUDIT_002",
      "statement": "The audit reports that, excluding the explicit time-step field, 21 local predictors (features 2-22 in the recovered feature numbering) are directly transaction-scoped and that three of those 21 feature meanings remained unidentified.",
      "source_ids": ["S3", "S4"]
    },
    {
      "id": "ELLIPTIC_AUDIT_003",
      "statement": "The audit reports that address-scoped features were computed relative to Bitcoin block height 575059 rather than each target transaction's own time.",
      "source_ids": ["S3", "S4"]
    },
    {
      "id": "ELLIPTIC_AUDIT_004",
      "statement": "The audit reports dataset-wide z-score preprocessing, temporal leakage from future-scoped address information, entity nonindependence across standard splits, and truncated released transaction neighborhoods.",
      "source_ids": ["S3"]
    },
    {
      "id": "BITCOIN_CAUSAL_001",
      "statement": "A non-coinbase Bitcoin transaction input spends an output of a previous transaction, giving transaction dependency edges a protocol-defined causal order.",
      "source_ids": ["S6"]
    }
  ],
